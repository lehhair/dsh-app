{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for dsh-app shell pages (launcher + settings overlay)",
  "windows": ["main", "win-*", "main-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "allow-app-info",
    "allow-status-bar-height",
    "allow-local-start",
    "allow-local-stop",
    "allow-local-status",
    "allow-local-logs",
    "allow-dsh-version",
    "allow-dsh-check-update",
    "allow-dsh-update",
    "allow-dsh-install",
    "allow-check-launcher-update",
    "allow-launcher-update",
    "allow-shell-connect",
    "allow-remote-connect",
    "allow-shell-back",
    "allow-shell-new-window",
    "allow-shell-ready",
    "allow-view-reload",
    "allow-open-devtools",
    "allow-remote-disconnect",
    "allow-remote-list",
    "allow-remote-save",
    "allow-remote-remove",
    "allow-remote-health",
    "allow-settings-open",
    "allow-settings-close",
    "allow-settings-current",
    "allow-settings-get-login-item",
    "allow-settings-set-login-item",
    "allow-settings-get-restore",
    "allow-settings-set-restore",
    "allow-settings-get-auto-local",
    "allow-settings-set-auto-local",
    "allow-theme-changed"
  ]
}
