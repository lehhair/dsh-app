{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.2.0",
  "identifier": "com.dshapp.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeepSeek Harness",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "backgroundColor": "#151517"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources": "resources"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "compression": "zlib"
      }
    }
  }
}
